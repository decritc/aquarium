{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/tank-item.schema.json",
  "title": "TankItemDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "category",
    "placement",
    "availability",
    "economy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "displayName": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "decoration",
        "plant",
        "coral",
        "substrate",
        "background",
        "equipment",
        "lighting",
        "consumable"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedTankEnvironments", "surface"],
      "properties": {
        "allowedTankEnvironments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "freshwater-tropical",
              "freshwater-coldwater",
              "freshwater-planted",
              "saltwater-reef",
              "saltwater-fish-only",
              "brackish"
            ]
          }
        },
        "requiredHabitatTags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "surface": {
          "type": "string",
          "enum": ["bottom", "midwater", "background", "free-floating", "equipment-slot"]
        },
        "footprint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "widthUnits": {
              "type": "number",
              "minimum": 0
            },
            "depthUnits": {
              "type": "number",
              "minimum": 0
            },
            "heightUnits": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes"],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["sandbox", "career", "observer"]
          }
        },
        "guestSandboxAvailable": {
          "type": "boolean"
        },
        "requiresAccount": {
          "type": "boolean"
        },
        "unlockIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visualThemeTags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tankStats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stat", "modifier"],
            "properties": {
              "stat": {
                "type": "string",
                "enum": [
                  "comfort",
                  "prestige",
                  "water-clarity",
                  "oxygenation",
                  "breeding-confidence",
                  "visitor-appeal"
                ]
              },
              "modifier": {
                "type": "number"
              }
            }
          }
        },
        "environmentRanges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "operation"],
            "properties": {
              "metric": {
                "type": "string",
                "enum": ["temperature-celsius", "ph", "salinity-ppt", "water-flow"]
              },
              "operation": {
                "type": "string",
                "enum": ["set-min-max", "add", "remove"]
              },
              "range": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                }
              },
              "value": {
                "type": "number"
              }
            }
          }
        },
        "speciesAffinities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tag", "modifier"],
            "properties": {
              "tag": {
                "type": "string"
              },
              "modifier": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "economy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purchasePrice"],
      "properties": {
        "purchasePrice": {
          "type": "number",
          "minimum": 0
        },
        "salePrice": {
          "type": "number",
          "minimum": 0
        },
        "premiumOnly": {
          "type": "boolean"
        }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelPath": {
          "type": "string"
        },
        "thumbnailPath": {
          "type": "string"
        }
      }
    }
  }
}
