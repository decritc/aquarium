{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/tank-backdrop.schema.json",
  "title": "TankBackdropDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "sourceType",
    "availability",
    "rendering"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "displayName": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "sourceType": {
      "type": "string",
      "enum": ["built-in", "user-upload"]
    },
    "themeTags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes"],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["sandbox", "career", "observer"]
          }
        },
        "guestSandboxAvailable": {
          "type": "boolean"
        },
        "requiresAccount": {
          "type": "boolean"
        },
        "allowPublicUse": {
          "type": "boolean"
        },
        "premiumOnly": {
          "type": "boolean"
        }
      }
    },
    "uploadRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userProvided": {
          "type": "boolean"
        },
        "requiresModeration": {
          "type": "boolean"
        },
        "maxFileSizeMb": {
          "type": "number",
          "minimum": 0
        },
        "allowedMimeTypes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imagePath"],
      "properties": {
        "imagePath": {
          "type": "string"
        },
        "focalPoint": {
          "type": "string",
          "enum": ["left", "center", "right"]
        },
        "recommendedTankThemes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "supportsColorTint": {
          "type": "boolean"
        }
      }
    }
  }
}
